import websocket
import json
import requests
import time

# --- CONFIGURATION ---
TELEGRAM_BOT_TOKEN = "YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID = "YOUR_CHAT_ID_HERE"
COIN_SYMBOL = "btcusdt"  # Must be lowercase for Binance WebSockets

# Prevent Telegram from rate-limiting you by spacing out alerts
last_alert_time = 0
ALERT_COOLDOWN = 60  # Wait 60 seconds between sending alerts

def send_telegram_alert(message):
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {"chat_id": TELEGRAM_CHAT_ID, "text": message}
    try:
        requests.post(url, json=payload)
    except Exception as e:
        print(f"Failed to send Telegram message: {e}")

def on_message(ws, message):
    global last_alert_time
    
    # Binance sends data as a JSON string; convert it to a Python dictionary
    data = json.loads(message)
    
    # 'c' is the current price, 's' is the trading pair symbol
    price = float(data['c'])
    symbol = data['s']
    
    print(f"Live {symbol} Price: {price}")
    
    # --- YOUR SCANNER LOGIC GOES HERE ---
    current_time = time.time()
    
    # The cooldown check prevents spamming Telegram every millisecond
    if current_time - last_alert_time > ALERT_COOLDOWN:
        
        # Example condition: Replace this with your actual scanning rules
        if price > 0: 
            send_telegram_alert(f"🚨 SCANNER ALERT: {symbol} is at {price}")
            last_alert_time = current_time

def on_error(ws, error):
    print(f"WebSocket Error: {error}")

def on_close(ws, close_status_code, close_msg):
    print("Connection closed.")

def on_open(ws):
    print("Successfully connected to the live Binance data stream!")

if __name__ == "__main__":
    # Target the specific ticker stream
    socket_url = f"wss://stream.binance.com:9443/ws/{COIN_SYMBOL}@ticker"
    
    # Initialize the WebSocket
    ws = websocket.WebSocketApp(
        socket_url,
        on_open=on_open,
        on_message=on_message,
        on_error=on_error,
        on_close=on_close
    )
    
    # This loop runs forever, processing new data as soon as Binance sends it
    ws.run_forever()
